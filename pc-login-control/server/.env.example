# =====================================================
# Vercel 環境変数（Vercel ダッシュボード or `vercel env` で設定）
#   ローカル開発では `vercel dev` がこの .env を読み込みます。
#   ※ .env は絶対にコミットしないでください（.gitignore 済み）。
# =====================================================

# Supabase プロジェクト設定 → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role キー（サーバー専用の秘密鍵。RLSをバイパスします。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# マスターパスワードの SHA-256（小文字HEX）
#   例: printf '%s' 'あなたのマスターPW' | sha256sum
MASTER_PASS_HASH=your_master_password_sha256
